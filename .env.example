# Copy to .env and fill in. .env is gitignored.
# chmod 600 .env after creating.

ANTHROPIC_API_KEY=

# ACLED — register free at https://acleddata.com/user/register
# Leave blank to skip the ACLED fetcher cleanly.
ACLED_USERNAME=
ACLED_PASSWORD=

# X/Twitter recent-search listener. Optional; daily cron skips cleanly if blank.
# X API access level determines how much this feed can collect.
X_BEARER_TOKEN=

# EIA energy fundamentals. Optional; register free at https://www.eia.gov/opendata/register.php
# Leave blank to skip the EIA fetcher cleanly.
EIA_API_KEY=

# Optional BLS key for higher request limits. The BLS fetcher can run without it.
BLS_API_KEY=

# SEC asks automated clients to identify themselves. Use a project/contact string.
SEC_USER_AGENT=macro-intelligence-engine/0.1 (contact@example.com)
REDDIT_USER_AGENT=macro-intelligence-engine/0.1

# Optional overrides (defaults set in config/config_fetch.py)
# MACRO_ENGINE_DB_PATH=data/macro_engine.db
# MACRO_ENGINE_LOG_DIR=data/logs
# MACRO_ENGINE_CLAUDE_MODEL=claude-haiku-4-5-20251001
